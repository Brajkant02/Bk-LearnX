# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

PORT=3000
FRONTEND_URL=http://localhost:3000/pages/auth/login/index.html

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty during local development to allow all origins (current behaviour).
ALLOWED_ORIGINS=

# Admin dashboard login (required — there is no built-in fallback anymore).
# Pick a new password; do not reuse one that has ever appeared in source code.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (used for password-reset OTP codes)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Optional: only needed if not using Gmail's default service
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook OAuth login
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# Learning-progress completion thresholds (all optional, sane defaults exist)
LEARNING_INACTIVITY_TIMEOUT=45
LEARNING_HEARTBEAT_INTERVAL=30
LEARNING_MIN_ACTIVE_SECONDS=300
LEARNING_MIN_READ_PROGRESS=90
LEARNING_MIN_SECTIONS_VIEWED=90
LEARNING_REQUIRE_QUIZ=true
